# Production environment variables (copy to .env.prod on the server)

# JWT secret for Flask-JWT-Extended (generate a long random string)
JWT_SECRET_KEY=CHANGE_ME

# Allowed CORS origins for the API (comma-separated)
CORS_ORIGINS=https://assettrack.gruen-ist-bund.de

# Public API base URL used by the browser (must include /api)
NEXT_PUBLIC_API_URL=https://api.assettrack.gruen-ist-bund.de/api
